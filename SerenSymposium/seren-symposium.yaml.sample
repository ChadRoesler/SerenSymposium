# ═══════════════════════════════════════════════════════════════════════
#  seren-symposium.yaml - the desktop front door.
#
#  Everything here is OPTIONAL; defaults assume the whole stack on
#  localhost. Symposium is a CLIENT: it holds the token it PRESENTS to
#  Lodestar, and authenticates nobody itself.
# ═══════════════════════════════════════════════════════════════════════

lodestar:
  url: "http://127.0.0.1:6361"
  # Longer than Lodestar's own 120s on purpose: when a model is cold-loading,
  # Lodestar answers with a 504 naming the node, and we must still be
  # listening to pass that on instead of a bare "unreachable".
  timeout_seconds: 180
  # ONE of these. Same precedence as every other service: inline, keyring, env.
  # bearer_token: ""
  # bearer_token_keyring: "seren-lodestar/alice"
  # bearer_token_env: "SEREN_LODESTAR_BEARER_TOKEN"

# ── The Backend cards ───────────────────────────────────────────────────
# These are the OTHER services' own /viewer pages, not copies of them: a card
# opens one in your browser. Blank one out to hide its card. A viewer can be a
# GROUP - names to URLs, a row of cards of its own - and Memory is one: memory
# is four stores.
viewers:
  memory:
    memory:      "http://127.0.0.1:7420/viewer"
    loci:        "http://127.0.0.1:7422/viewer"
    callosum:    "http://127.0.0.1:7423/viewer"
    hippocampus: "http://127.0.0.1:7424/viewer"
  tools:   "http://127.0.0.1:7425/viewer"
  cluster: "http://127.0.0.1:6361/viewer"
  probe:   ""

ui:
  host: 127.0.0.1        # loopback ONLY - there is no inbound auth
  port: 7426
  confirm_destructive: true
  you: "you"             # your name on your own messages
  # What you send while an answer is coming waits above the box. Once the answer
  # is in: meld (all of it as one message), each (one at a time) or hold (it waits
  # for you). Every chat's default; a chat can say otherwise. Set from Settings too.
  queue: "meld"
  # ...and WHEN it goes: round (when the answer, or a room's whole round, is in),
  # seat (a room: when the seat speaking is done; the rest are not asked) or now
  # (the answer is stopped and it goes). Every chat's default; a chat can say
  # otherwise, and so can a single message, beside the send button.
  interrupt: "round"
  # What the picture panel's translate drafts a prompt from: plain (your words),
  # chat (your words and the chat's recent messages) or fork (a throwaway copy of
  # the chat's own Claude conversation - it knows everything, and is the slow one).
  # Every chat's default; a chat can say otherwise. Set from Settings too.
  translate: "chat"
  translate_messages: 12       # chat: how many of the latest messages go along
  translate_max_chars: 8000    # ...and how much of them at most

# ── What the window sets wins ──────────────────────────────────────────
# Your name, Claude's, its permissions and folders, confirm_destructive and the
# projects can all be changed in Settings. Those changes are kept in
# symposium-prefs.json beside the sessions folder - NOT here, because an
# installer rewrites this file - and are laid over it at start. Until a thing
# is changed in the window, the value here shows through.
  window_width: 1280
  window_height: 860

# ── Folders are CONTEXT BOUNDARIES, not filing ─────────────────────────
# A folder carries defaults that its sessions inherit, so a session started
# in "seren stack" already knows what it is about and one in "general" does
# not drag that context along. A session's own settings still override any of it.
# The shell shows folders as PROJECTS and sessions as CHATS. These seed the
# projects; once one is made, renamed or changed in the window, the prefs
# file owns the list.
folders:
  - name: "seren stack"
    voice: ""                            # "" / "lodestar": a local model; "claude": see below
    system_prompt: "You are working on the Seren services. Prefer real bytes over recollection."
    model: ""
    temperature: 0.6
    # max_tokens: 1024
    # repeat_penalty: 1.1
    memory_tags: ["seren", "infra"]      # not wired yet: nothing reads it

  - name: "general"
    system_prompt: ""
    temperature: 0.9

# ── Sessions: one JSON file each, kept on this machine ─────────────────
# Blank: a `sessions` folder next to this file (~/seren-symposium/sessions
# when there is no file). Back it up like anything else you'd miss.
sessions:
  dir: ""

# ── The claude voice: chats where Claude answers ───────────────────────
# A folder (or one chat, in its settings) with voice: "claude" is answered
# by the `claude` CLI on THIS machine instead of a local model through
# Lodestar - with the CLI's own login, MCP servers and hooks. Each chat is
# one CLI conversation, resumed turn after turn. The command is yours;
# a request only ever supplies the prompt (on stdin).
claude:
  enabled: true
  name: "claude"            # what the answers are signed as in the shell
  command: ["claude"]
  cwd: ""                   # decides which project settings / MCP servers load
  model: ""                 # blank: the CLI's default; a folder or chat can name one
  permission_mode: ""       # -p can't ask at a terminal, so...
  ask: true                 # ...a tool not listed below is asked about IN THE WINDOW (Allow once / Always / Deny)
  allowed_tools: []         # what it may use without asking, e.g. ["mcp__workbench__*"]
  # Both are EVERY CHAT's: the carabiner's session: block sits under them, a
  # project's and a chat's own over them (the most particular mode wins; the
  # allow lists add up unless a project or chat says not to inherit).
  add_dirs: []              # folders it may work in besides cwd
  carabiner: ""             # the Claude Code carabiner's claude.yaml, shown in Settings; blank looks for it
  timeout_seconds: 900
  save_files: true          # may write into the chat's own folder - a drawing, notes - and only there
  handover_max_chars: 100000  # how much of the chat a NEW claude conversation is handed
  # framing: "..."          # what each turn is told about the window ({files} = the chat's folder)
  # room_framing: "..."     # what each seat of a room is told ({seats} {me} {you})
  # A command Claude starts in the background outlives the answer: the chat goes
  # on, it can still be asked things, and it comes back to say when the task ends.
  # false: the old way - the process, and anything it left running, ends with its answer.
  background: true
  background_max_seconds: 7200   # the longest a set-aside process is left running
  room_volleys: 6           # a room: turns seats may take by calling on each other (@name) per message; 0 = they can't
  mcp_servers: []           # only these MCP servers (names from ~/.claude.json) are loaded, e.g. ["wren-workbench"];
                            # empty = every server the CLI knows
  mcp_always_load: []       # of mcp_servers, the ones whose tools are loaded up front instead of found through
                            # ToolSearch, e.g. ["wren-workbench"]; costs each turn that server's whole tool list
  builtin_tools: []         # Claude Code's own tools, cut down to these (ToolSearch is always kept); empty = all,
                            # e.g. ["Bash", "PowerShell", "Read", "Edit", "Write", "Glob", "Grep", "Task", "WebSearch"]
  skills: true              # its skills and slash commands; false = none of them (and no Skill tool)
  claudeai_connectors: false  # the account's claude.ai connectors (Gmail, Drive...) as MCP servers; off = not loaded
  auto_memory: last_resort  # Claude Code's own MEMORY.md: last_resort (kept, and each turn is told to use the
                            # house's memory tools first) | off (the CLI starts without it) | on (as Claude Code has it)
  # auto_memory_note: "..." # what each turn is told when auto_memory is last_resort
  # tools_note: "..."       # what each turn is told about the house's own tools when mcp_servers names them
                            # ({servers} = the names); blank says nothing
  # The preface: Margin's page (GET /preface) read to the model as its system
  # prompt IN PLACE of the CLI's own; the folder's prompt and the framing are
  # appended to it. Blank = the CLI keeps its prompt. A Margin that does not
  # answer costs the page, never the turn.
  preface:
    url: ""                 # Margin's base url, e.g. http://nuc:7251
    bearer_token: ""        # or bearer_token_env / bearer_token_keyring
    file: ""                # or a file on this box (wins over url)

# ── Files and screen share ─────────────────────────────────────────────
files:
  max_mb: 25                # one attachment's ceiling
  inline_max_chars: 20000   # text a local model is given from a message's files
  fetch_images: true        # web images an answer shows are saved into the chat

screen:                     # stills of this desktop (needs the [desktop] or [screen] extra)
  enabled: true
  max_width: 1600
  jpeg_quality: 80

speech:                     # "say it" on an answer: the assistant's voice from Lodestar's speaker
  enabled: true
  voice: ""                 # a voice the speaker has; blank = its default (wren)
  timeout_seconds: 240      # saying it, the wake of the speaker included
  max_chars: 4000           # longer answers are said up to here and say so

ears:                       # push-to-talk (needs the [desktop] or [ears] extra)
  enabled: true
  device: ""                # part of an input's name ("USB Microphone", "Stereo Mix"); blank = the default
  language: "en"            # whisper's hint; blank lets it guess
  max_seconds: 120          # a clip stops growing here
  timeout_seconds: 150      # hearing, the wake of whisper included

updates:
  enabled: true
  check_interval_hours: 6
  allow_prerelease: false
